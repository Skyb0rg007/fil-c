diff --git a/mutter/clutter/clutter/clutter-paint-node.c b/mutter/clutter/clutter/clutter-paint-node.c
--- a/mutter/clutter/clutter/clutter-paint-node.c
+++ b/mutter/clutter/clutter/clutter-paint-node.c
@@ -223,9 +223,11 @@
 GType
 clutter_paint_node_get_type (void)
 {
-  static size_t paint_node_type_id = 0;
+  /* Fil-C: GType is a pointer type, so the id slot must be a gpointer and
+     the pointer variants of g_once_init_enter/leave must be used. */
+  static gpointer paint_node_type_id = 0;

-  if (g_once_init_enter (&paint_node_type_id))
+  if (g_once_init_enter_pointer (&paint_node_type_id))
     {
       static const GTypeFundamentalInfo finfo = {
         (G_TYPE_FLAG_CLASSED |
@@ -267,10 +269,10 @@
                                      &node_info, &finfo,
                                      G_TYPE_FLAG_ABSTRACT);

-      g_once_init_leave (&paint_node_type_id, id);
+      g_once_init_leave_pointer (&paint_node_type_id, id);
     }

-  return paint_node_type_id;
+  return (GType) paint_node_type_id;
 }

