diff --git a/mutter/src/compositor/meta-sync-ring.c b/mutter/src/compositor/meta-sync-ring.c
--- a/mutter/src/compositor/meta-sync-ring.c
+++ b/mutter/src/compositor/meta-sync-ring.c
@@ -34,7 +34,12 @@

 #include <string.h>
 #include <GL/gl.h>
+/* Fil-C: our mesa is Wayland-only and ships no GL/glx.h.  This file only
+   uses GL types from GL/gl.h plus Xlib/XSync, so the GLX header is only
+   pulled in when GLX support is actually built. */
+#ifdef HAVE_GLX
 #include <GL/glx.h>
+#endif
 #include <X11/extensions/sync.h>

 #include "clutter/clutter.h"
diff --git a/mutter/src/frames/meson.build b/mutter/src/frames/meson.build
--- a/mutter/src/frames/meson.build
+++ b/mutter/src/frames/meson.build
@@ -6,6 +6,10 @@
   'meta-window-tracker.c',
 ]

+# Fil-C: mutter-x11-frames needs GTK4 with the X11 backend (gdk/x11/gdkx.h)
+# and is only ever used together with Xwayland.  Skip it when Xwayland is
+# disabled (our gtk4 is built without the X11 backend).
+if have_xwayland
 x11_frames = executable('mutter-x11-frames',
   sources: x11_frames_sources,
   dependencies: [
@@ -23,3 +27,6 @@
   install: true,
   install_dir: get_option('libexecdir'),
 )
+else
+  x11_frames = disabler()
+endif
