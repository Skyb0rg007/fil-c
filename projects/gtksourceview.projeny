 	/**
 	 * GtkSourceVimIMContext::format-text:
@@ -483,7 +483,7 @@
 		              G_TYPE_NONE,
 		              2,
 		              GTK_SOURCE_TYPE_VIEW,
-		              G_TYPE_STRING | G_SIGNAL_TYPE_STATIC_SCOPE);
+		              (GType) ((uintptr_t) G_TYPE_STRING | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));

 	/**
 	 * GtkSourceVimIMContext::edit:
@@ -510,7 +510,7 @@
 		              G_TYPE_NONE,
 		              2,
 		              GTK_SOURCE_TYPE_VIEW,
-		              G_TYPE_STRING | G_SIGNAL_TYPE_STATIC_SCOPE);
+		              (GType) ((uintptr_t) G_TYPE_STRING | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));
 }

 static void
