URL: https://ftp.gnome.org/pub/GNOME/sources/gtksourceview/5.12/gtksourceview-5.12.1.tar.xz 972d23d8978bee06f0fa21ae35e44c7788c45d52fca6457c2ecb5a4ac6b7717e
Origname: gtksourceview-5.12.1
Name: gtksourceview

    Fil-C patch for gtksourceview
diff --git a/gtksourceview/gtksourceview/gtksourcebuffer.c b/gtksourceview/gtksourceview/gtksourcebuffer.c
--- a/gtksourceview/gtksourceview/gtksourcebuffer.c
+++ b/gtksourceview/gtksourceview/gtksourcebuffer.c
@@ -419,8 +419,8 @@
 					_gtk_source_marshal_VOID__BOXED_BOXED,
 	                                G_TYPE_NONE,
 	                                2,
-	                                GTK_TYPE_TEXT_ITER | G_SIGNAL_TYPE_STATIC_SCOPE,
-	                                GTK_TYPE_TEXT_ITER | G_SIGNAL_TYPE_STATIC_SCOPE);
+	                                (GType) ((uintptr_t) GTK_TYPE_TEXT_ITER | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE),
+	                                (GType) ((uintptr_t) GTK_TYPE_TEXT_ITER | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));
 	g_signal_set_va_marshaller (buffer_signals[HIGHLIGHT_UPDATED],
 	                            G_TYPE_FROM_CLASS (klass),
 	                            _gtk_source_marshal_VOID__BOXED_BOXEDv);
diff --git a/gtksourceview/gtksourceview/gtksourcegutterrenderer.c b/gtksourceview/gtksourceview/gtksourcegutterrenderer.c
--- a/gtksourceview/gtksourceview/gtksourcegutterrenderer.c
+++ b/gtksourceview/gtksourceview/gtksourcegutterrenderer.c
@@ -502,8 +502,8 @@
 		              _gtk_source_marshal_VOID__BOXED_BOXED_UINT_FLAGS_INT,
 		              G_TYPE_NONE,
 		              5,
-		              GTK_TYPE_TEXT_ITER | G_SIGNAL_TYPE_STATIC_SCOPE,
-		              GDK_TYPE_RECTANGLE | G_SIGNAL_TYPE_STATIC_SCOPE,
+		              (GType) ((uintptr_t) GTK_TYPE_TEXT_ITER | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE),
+		              (GType) ((uintptr_t) GDK_TYPE_RECTANGLE | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE),
 		              G_TYPE_UINT,
 		              GDK_TYPE_MODIFIER_TYPE,
 		              G_TYPE_INT);
@@ -530,8 +530,8 @@
 		              _gtk_source_marshal_BOOLEAN__BOXED_BOXED,
 		              G_TYPE_BOOLEAN,
 		              2,
-		              GTK_TYPE_TEXT_ITER | G_SIGNAL_TYPE_STATIC_SCOPE,
-		              GDK_TYPE_RECTANGLE | G_SIGNAL_TYPE_STATIC_SCOPE);
+		              (GType) ((uintptr_t) GTK_TYPE_TEXT_ITER | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE),
+		              (GType) ((uintptr_t) GDK_TYPE_RECTANGLE | (uintptr_t) G_SIGNAL_TYPE_STATIC_SCOPE));
 	g_signal_set_va_marshaller (signals[QUERY_ACTIVATABLE],
 	                            G_TYPE_FROM_CLASS (klass),
 	                            _gtk_source_marshal_BOOLEAN__BOXED_BOXEDv);
diff --git a/gtksourceview/gtksourceview/gtksourceutils.c b/gtksourceview/gtksourceview/gtksourceutils.c
--- a/gtksourceview/gtksourceview/gtksourceutils.c
+++ b/gtksourceview/gtksourceview/gtksourceutils.c
@@ -971,7 +971,7 @@
 static PangoFontMap *
 load_override_font_fc (void)
 {
-	static FcConfig *map_font_config;
+	static gpointer map_font_config; /* Fil-C: once-init statics for pointers use the _pointer variants. */
 	PangoFontMap *font_map = NULL;

 	font_map = pango_cairo_font_map_new_for_font_type (CAIRO_FONT_TYPE_FT);
@@ -982,7 +982,7 @@
 		return NULL;
 	}

-	if (g_once_init_enter (&map_font_config))
+	if (g_once_init_enter_pointer (&map_font_config)) /* Fil-C: pointer once-init statics. */
 	{
 		char **font_dirs = _gtk_source_utils_get_default_dirs ("fonts");
 		FcConfig *config = FcInitLoadConfigAndFonts ();
@@ -1011,12 +1011,12 @@

 		g_strfreev (font_dirs);

-		g_once_init_leave (&map_font_config, config);
+		g_once_init_leave_pointer (&map_font_config, config);
 	}

 	g_assert (map_font_config != NULL);

-	pango_fc_font_map_set_config (PANGO_FC_FONT_MAP (font_map), map_font_config);
+	pango_fc_font_map_set_config (PANGO_FC_FONT_MAP (font_map), (FcConfig *) map_font_config);

 	return font_map;
 }
