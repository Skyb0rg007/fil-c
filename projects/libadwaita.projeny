URL: https://download.gnome.org/sources/libadwaita/1.5/libadwaita-1.5.8.tar.xz 15365f9fce28861ec4d60ea9e9585d78d3f23d3bc8be742cb3d70dd86508b0c1
URL: https://ftp.gnome.org/pub/GNOME/sources/libadwaita/1.5/libadwaita-1.5.8.tar.xz 15365f9fce28861ec4d60ea9e9585d78d3f23d3bc8be742cb3d70dd86508b0c1
Origname: libadwaita-1.5.8
Name: libadwaita

    Fil-C patch for libadwaita
diff --git a/libadwaita/libadwaita.syms b/libadwaita/libadwaita.syms
--- a/libadwaita/libadwaita.syms
+++ b/libadwaita/libadwaita.syms
@@ -1,6 +1,10 @@
 LIBADWAITA_1_0 {
 	global:
 		adw_*;
+		/* Fil-C: the pizlonator renames symbol definitions and references
+		   with a pizlonated_ prefix; the renamed functions must stay
+		   exported or consumers of this library cannot link. */
+		pizlonated*;
 	local:
 		*;
 };
