URL: https://github.com/ximion/appstream/archive/v1.0.3/appstream-1.0.3.tar.gz 0a076bcd1b3925b97d06f1092ca48c69071917c32383b8b5df35286e53658982
Origname: appstream-1.0.3
Name: appstream

    Fil-C patch for appstream
diff --git a/appstream/data/meson.build b/appstream/data/meson.build
--- a/appstream/data/meson.build
+++ b/appstream/data/meson.build
@@ -24,11 +24,13 @@
     command : [ascli_exe, 'news-to-metainfo', '--limit=6', '@INPUT0@', '@INPUT1@', '@OUTPUT@']
 )

-metainfo_i18n = i18n.itstool_join(
-    input:  metainfo_with_relinfo,
+# Fil-C port: itstool is not available in this build environment, so the
+# CLI metainfo file is installed untranslated instead of being joined with
+# the translations (the translations are irrelevant for this port).
+metainfo_i18n = custom_target('metainfo-i18n',
+    input: metainfo_with_relinfo,
     output: 'org.freedesktop.appstream.cli.metainfo.xml',
-    mo_targets: i18n_result[0],
-    its_files: [join_paths(meson.current_source_dir(), 'its', 'metainfo.its')],
+    command: ['cp', '@INPUT@', '@OUTPUT@'],
     install: true,
     install_dir: metainfo_dir,
 )
diff --git a/appstream/meson.build b/appstream/meson.build
--- a/appstream/meson.build
+++ b/appstream/meson.build
@@ -223,7 +223,14 @@
 subdir('po/')
 subdir('data/')
 subdir('contrib/')
-subdir('docs/')
+# Fil-C port: the docs subdirectory hard-requires the Docbook XSL
+# stylesheets (only for man-page generation), which this build environment
+# does not have. The man pages are not needed here, so docs/ is skipped.
+if not get_option('docs')
+    message('Fil-C port: skipping docs/ (no Docbook XSL stylesheets)')
+else
+    subdir('docs/')
+endif
 subdir('tests/')
 if get_option('qt')
     subdir('qt/')
