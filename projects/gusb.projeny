URL: https://people.freedesktop.org/~hughsient/releases/libgusb-0.4.2.tar.xz 8a8583d69a63b1d314a81f2fcbb6f20ecf3f90e169cff85649b8a401c53b9ca2
URL: https://github.com/hughsie/libgusb/archive/0.4.2/libgusb-0.4.2.tar.gz 59b9d2b5d7d99161f646afdae233921cfbccf37bad10c43fa147f8d529cb0d62
Origname: libgusb-0.4.2
Name: gusb

    Fil-C patch for gusb
diff --git a/gusb/gusb/libgusb.ver b/gusb/gusb/libgusb.ver
--- a/gusb/gusb/libgusb.ver
+++ b/gusb/gusb/libgusb.ver
@@ -1,7 +1,10 @@
 # generated automatically, do not edit!
+# (Fil-C: pizlonated* added - the pizlonator renames symbols with a
+#  pizlonated_ prefix.)

 LIBGUSB_0.1.0 {
   global:
+    pizlonated*;
     g_usb_context_error_quark;
     g_usb_context_get_source;
     g_usb_context_get_type;
diff --git a/gusb/gusb/libgusb_meson.ver b/gusb/gusb/libgusb_meson.ver
--- a/gusb/gusb/libgusb_meson.ver
+++ b/gusb/gusb/libgusb_meson.ver
@@ -1,6 +1,8 @@
 LIBGUSB_0.1.0 {
   global:
     g_usb_*;
+    /* Fil-C: the pizlonator renames symbols with a pizlonated_ prefix. */
+    pizlonated*;
     environ;
     __progname;
   local: *;
