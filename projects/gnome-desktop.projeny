URL: https://download.gnome.org/sources/gnome-desktop/44/gnome-desktop-44.5.tar.xz 6d45202e38616fd6ce5f097efe94265be12a9f3b028f20c637e2a4d91bdf7fd2
URL: https://ftp.gnome.org/pub/GNOME/sources/gnome-desktop/44/gnome-desktop-44.5.tar.xz 6d45202e38616fd6ce5f097efe94265be12a9f3b028f20c637e2a4d91bdf7fd2
Origname: gnome-desktop-44.5
Name: gnome-desktop

    Fil-C patch for gnome-desktop
diff --git a/gnome-desktop/libgnome-desktop/base-symbol.map b/gnome-desktop/libgnome-desktop/base-symbol.map
--- a/gnome-desktop/libgnome-desktop/base-symbol.map
+++ b/gnome-desktop/libgnome-desktop/base-symbol.map
@@ -1,6 +1,10 @@
 {
 global:
   gnome_*;
+  /* Fil-C: the pizlonator renames symbol references with a pizlonated_
+     prefix; the thunks must stay exported for the sibling libraries
+     (libgnome-bg-4, libgnome-rr-4) to link. */
+  pizlonated*;
 local:
   gnome_desktop_thumbnail_script_exec;
   *;
diff --git a/gnome-desktop/libgnome-desktop/gnome-bg/gnome-bg-symbols.map b/gnome-desktop/libgnome-desktop/gnome-bg/gnome-bg-symbols.map
--- a/gnome-desktop/libgnome-desktop/gnome-bg/gnome-bg-symbols.map
+++ b/gnome-desktop/libgnome-desktop/gnome-bg/gnome-bg-symbols.map
@@ -1,6 +1,8 @@
 {
 global:
   gnome_bg_*;
+  /* Fil-C: keep the pizlonated_ thunks exported (see ../base-symbol.map). */
+  pizlonated*;
 local:
   *;
 };
diff --git a/gnome-desktop/libgnome-desktop/gnome-rr/gnome-rr-symbols.map b/gnome-desktop/libgnome-desktop/gnome-rr/gnome-rr-symbols.map
--- a/gnome-desktop/libgnome-desktop/gnome-rr/gnome-rr-symbols.map
+++ b/gnome-desktop/libgnome-desktop/gnome-rr/gnome-rr-symbols.map
@@ -1,6 +1,8 @@
 {
 global:
   gnome_rr_*;
+  /* Fil-C: keep the pizlonated_ thunks exported (see ../base-symbol.map). */
+  pizlonated*;
 local:
   *;
 };
diff --git a/gnome-desktop/libgnome-desktop/gnome-rr/meson.build b/gnome-desktop/libgnome-desktop/gnome-rr/meson.build
--- a/gnome-desktop/libgnome-desktop/gnome-rr/meson.build
+++ b/gnome-desktop/libgnome-desktop/gnome-rr/meson.build
@@ -57,7 +57,10 @@
     install: true,
   )
 else
-  libgnome_rr_gir = ''
+  # Fil-C: must be an empty list, not '' -- meson chokes on the empty
+  # string when it is spliced into declare_dependency(sources:) below
+  # ("File  does not exist").  gnome-bg/meson.build already uses [].
+  libgnome_rr_gir = []
 endif


diff --git a/gnome-desktop/libgnome-desktop/symbol.map b/gnome-desktop/libgnome-desktop/symbol.map
--- a/gnome-desktop/libgnome-desktop/symbol.map
+++ b/gnome-desktop/libgnome-desktop/symbol.map
@@ -1,6 +1,8 @@
 {
 global:
   gnome_*;
+  /* Fil-C: keep the pizlonated_ thunks exported (see base-symbol.map). */
+  pizlonated*;
 local:
   *;
 };
