[Desktop Entry]
Type=Application
Name=Mutter (Wayland)
# The wrapper launches mutter --wayland, waits for the Wayland socket,
# and registers the client with gnome-session (org.gnome.SessionManager
# RegisterClient using DESKTOP_AUTOSTART_ID) so the phase machinery
# treats mutter as up instead of timing out after 90 seconds.
Exec=/usr/bin/pizlix-mutter
# DisplayServer, not WindowManager: mutter publishes WAYLAND_DISPLAY to
# the session via org.gnome.SessionManager.Setenv, which gnome-session
# only accepts in phases up to Initialization (gnome-shell does exactly
# this in real GNOME).
X-GNOME-Autostart-Phase=DisplayServer
NoDisplay=true
